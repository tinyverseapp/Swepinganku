rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function isValidSweepingPatient(data) {
      return data.keys().hasAll(['id', 'name', 'jk', 'rm', 'room', 'dpjp', 'date', 'division'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (data.jk == 'L' || data.jk == 'P' || data.jk == '')
        && (!('age' in data) || (data.age is string && data.age.size() <= 50))
        && data.rm is string && data.rm.size() <= 50
        && data.room is string && data.room.size() <= 100
        && (!('kamar' in data) || (data.kamar is string && data.kamar.size() <= 50))
        && data.dpjp is string && data.dpjp.size() <= 200
        && (!('dx' in data) || (data.dx is string && data.dx.size() <= 1000))
        && data.date is string && data.date.size() <= 20
        && data.division is string && data.division.size() <= 100
        && (!('teamCode' in data) || (data.teamCode is string && data.teamCode.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50))
        && (!('doctorRole' in data) || data.doctorRole == 'DPJP' || data.doctorRole == 'RABER' || data.doctorRole == 'KONSUL')
        && (!('supervisingDpjp' in data) || (data.supervisingDpjp is string && data.supervisingDpjp.size() <= 200));
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['teamCode', 'division', 'teamName', 'weekStart', 'weekEnd'])
        && data.teamCode is string && data.teamCode.size() > 0 && data.teamCode.size() <= 50
        && data.division is string && data.division.size() > 0 && data.division.size() <= 100
        && data.teamName is string && data.teamName.size() > 0 && data.teamName.size() <= 200
        && data.weekStart is string && data.weekStart.size() == 10
        && data.weekEnd is string && data.weekEnd.size() == 10
        && (!('members' in data) || data.members is list);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'm.hafidzuddin.s@gmail.com';
    }

    function isTeamMember(teamCode) {
      return request.auth != null && exists(/databases/$(database)/documents/teamMembers/$(teamCode)/members/$(request.auth.uid));
    }

    match /sweepinganku/{patientId} {
      allow read: if request.auth != null && (isTeamMember(resource.data.teamCode) || isAdmin());
      allow create: if request.auth != null && isValidId(patientId) && isValidSweepingPatient(request.resource.data) && (isTeamMember(request.resource.data.teamCode) || isAdmin());
      allow update: if request.auth != null && isValidId(patientId) && isValidSweepingPatient(request.resource.data) && (isTeamMember(request.resource.data.teamCode) || isAdmin());
      allow delete: if request.auth != null && isValidId(patientId) && (isTeamMember(resource.data.teamCode) || isAdmin());
    }

    // Permanent weekly census/history. History may be created or updated by
    // authenticated users, but is never deleted by the application.
    match /sweepingankuWeekly/{historyId} {
      allow read, write: if false;
    }

    match /teams/{teamCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && isValidId(teamCode)
        && isValidTeam(request.resource.data)
        && request.resource.data.teamCode == teamCode;
      allow update: if request.auth != null
        && isValidId(teamCode)
        && isValidTeam(request.resource.data)
        && request.resource.data.teamCode == teamCode;
      allow delete: if false;
    }

    match /teamMembers/{teamCode}/members/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // AI quota is controlled by the authenticated user's Firebase ID token.
    // The application server performs the atomic transaction; users can only
    // access their own quota records and cannot touch another user's quota.
    match /aiUsage/{uid}/daily/{date} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == uid
        && date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.uid == uid
        && request.resource.data.date == date
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 5
        && request.resource.data.keys().hasOnly(['uid', 'date', 'count', 'updatedAt']);
      allow delete: if false;
    }
  }
}
