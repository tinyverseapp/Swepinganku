rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    function isValidSweepingPatient(data) {
      return data.keys().hasAll(['id', 'name', 'jk', 'rm', 'room', 'dpjp', 'date', 'division'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (data.jk == 'L' || data.jk == 'P')
        && (!('age' in data) || (data.age is string && data.age.size() <= 50))
        && data.rm is string && data.rm.size() <= 50
        && data.room is string && data.room.size() <= 100
        && (!('kamar' in data) || (data.kamar is string && data.kamar.size() <= 50))
        && data.dpjp is string && data.dpjp.size() <= 200
        && (!('dx' in data) || (data.dx is string && data.dx.size() <= 1000))
        && data.date is string && data.date.size() <= 20
        && data.division is string && data.division.size() <= 100
        && (!('teamCode' in data) || (data.teamCode is string && data.teamCode.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['teamCode', 'division', 'teamName', 'weekStart', 'weekEnd'])
        && data.teamCode is string && data.teamCode.size() > 0 && data.teamCode.size() <= 50
        && data.division is string && data.division.size() > 0 && data.division.size() <= 100
        && data.teamName is string && data.teamName.size() > 0 && data.teamName.size() <= 200
        && data.weekStart is string && data.weekStart.size() == 10
        && data.weekEnd is string && data.weekEnd.size() == 10
        && (!('members' in data) || data.members is list);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /sweepinganku/{patientId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidId(patientId) && isValidSweepingPatient(request.resource.data);
      allow update: if request.auth != null && isValidId(patientId) && isValidSweepingPatient(request.resource.data);
      allow delete: if request.auth != null && isValidId(patientId);
    }

    // Shared team document. Any authenticated member who knows the team PIN
    // can read/update the shared team name. This is required so a name change
    // propagates to every account currently using the same team.
    match /teams/{teamCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && isValidId(teamCode)
        && isValidTeam(request.resource.data)
        && request.resource.data.teamCode == teamCode;
      allow update: if request.auth != null
        && isValidId(teamCode)
        && isValidTeam(request.resource.data)
        && request.resource.data.teamCode == teamCode;
      allow delete: if false;
    }

    match /teamMembers/{teamCode}/members/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
