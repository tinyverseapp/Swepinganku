{
  "entities": {
    "SweepingPatient": {
      "title": "SweepingPatient",
      "description": "Data rekam sweeping pasien bedah per tanggal dan tim untuk sinkronisasi antar perangkat",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik rekam pasien",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Nama pasien",
          "maxLength": 200
        },
        "jk": {
          "type": "string",
          "description": "Jenis kelamin L atau P",
          "enum": ["L", "P"]
        },
        "dob": {
          "type": "string",
          "description": "Tanggal lahir pasien (DOB) format YYYY-MM-DD",
          "maxLength": 50
        },
        "age": {
          "type": "string",
          "description": "Usia pasien beserta satuan",
          "maxLength": 50
        },
        "rm": {
          "type": "string",
          "description": "Nomor Rekam Medis pasien",
          "maxLength": 50
        },
        "room": {
          "type": "string",
          "description": "Nama ruangan atau bangsal",
          "maxLength": 100
        },
        "kamar": {
          "type": "string",
          "description": "Nomor kamar atau bed pasien",
          "maxLength": 50
        },
        "dpjp": {
          "type": "string",
          "description": "Nama dokter DPJP",
          "maxLength": 200
        },
        "dx": {
          "type": "string",
          "description": "Diagnosis klinis pasien",
          "maxLength": 1000
        },
        "date": {
          "type": "string",
          "description": "Tanggal sweeping format YYYY-MM-DD",
          "maxLength": 20
        },
        "division": {
          "type": "string",
          "description": "Divisi bedah",
          "maxLength": 100
        },
        "teamCode": {
          "type": "string",
          "description": "Kode tim atau PIN divisi",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu terakhir pembaruan",
          "maxLength": 50
        },
        "presenceStatus": {
          "type": "string",
          "description": "Status tanda sweeping pagi: belum_periksa (belum dicek di ruangan), ada (masih ada di ruangan), atau pulang (tanda sudah pulang/rencana pulang)",
          "enum": ["belum_periksa", "ada", "pulang"]
        },
        "weeklyStatus": {
          "type": "string",
          "description": "Klasifikasi pasien mingguan: baru (pasien baru masuk di minggu ini), lama (pasien dari minggu/periode sebelumnya)",
          "enum": ["baru", "lama", ""]
        },
        "admissionDate": {
          "type": "string",
          "description": "Tanggal masuk rawat inap / tanggal pasien pertama kali diinput format YYYY-MM-DD",
          "maxLength": 50
        }
      },
      "required": ["id", "name", "jk", "rm", "room", "dpjp", "date", "division"]
    },
    "DivisionTeam": {
      "title": "DivisionTeam",
      "description": "Informasi tim divisi koas dan rentang tanggal pekan dinas",
      "type": "object",
      "properties": {
        "teamCode": {
          "type": "string",
          "description": "Kode PIN tim divisi",
          "maxLength": 50
        },
        "division": {
          "type": "string",
          "description": "Nama divisi bedah",
          "maxLength": 100
        },
        "teamName": {
          "type": "string",
          "description": "Nama kelompok tim",
          "maxLength": 200
        },
        "weekStart": {
          "type": "string",
          "description": "Tanggal awal pekan format YYYY-MM-DD",
          "maxLength": 10
        },
        "weekEnd": {
          "type": "string",
          "description": "Tanggal akhir pekan format YYYY-MM-DD",
          "maxLength": 10
        }
      },
      "required": ["teamCode", "division", "teamName", "weekStart", "weekEnd"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Anggota koas yang terdaftar dalam tim divisi",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID unik pengguna Firebase Auth",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap koas",
          "maxLength": 200
        },
        "email": {
          "type": "string",
          "description": "Alamat email koas",
          "maxLength": 320
        }
      },
      "required": ["uid", "name", "email"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil dan daftar tim yang diikuti akun pengguna untuk sinkronisasi antar perangkat",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID unik pengguna Firebase Auth",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Alamat email pengguna",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "description": "Nama tampilan pengguna",
          "maxLength": 200
        },
        "joinedTeamCodes": {
          "type": "array",
          "description": "Daftar kode tim yang diikuti akun pengguna",
          "items": {
            "type": "string"
          }
        },
        "activeTeamCode": {
          "type": "string",
          "description": "Kode tim yang sedang aktif dipilih",
          "maxLength": 50
        },
        "lastUpdated": {
          "type": "string",
          "description": "Waktu pembaruan terakhir format ISO string",
          "maxLength": 50
        }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/sweepinganku/{patientId}": {
      "schema": "#/entities/SweepingPatient",
      "description": "Koleksi sweepinganku berisi data pasien yang disinkronkan antar perangkat secara real-time"
    },
    "/teams/{teamCode}": {
      "schema": "#/entities/DivisionTeam",
      "description": "Informasi kelompok tim divisi koas dan rentang pekan aktif"
    },
    "/teamMembers/{teamCode}/members/{uid}": {
      "schema": "#/entities/TeamMember",
      "description": "Daftar kehadiran dan anggota aktif per tim divisi"
    },
    "/users/{uid}": {
      "schema": "#/entities/UserProfile",
      "description": "Profil akun pengguna dan sinkronisasi tim yang diikuti antar perangkat"
    }
  }
}
